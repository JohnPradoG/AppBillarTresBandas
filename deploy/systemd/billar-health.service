[Unit]
Description=Monitor de salud de la grabación
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=billar
Group=billar
Environment=BILLAR_CONFIG=/etc/billar/billar.toml
ExecStart=/opt/billar/current/venv/bin/billar health
Restart=always
RestartSec=2
WatchdogSec=30

[Install]
WantedBy=multi-user.target
