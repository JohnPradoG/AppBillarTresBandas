[Unit]
Description=Pantalla táctil de la mesa (navegador en modo kiosco)
After=billar-ui.service systemd-user-sessions.service
Wants=billar-ui.service
# Ocupa la consola tty1 en lugar del inicio de sesión de texto.
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=billar-kiosko
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# cage: compositor Wayland mínimo que muestra una sola aplicación a pantalla completa.
ExecStart=/usr/bin/cage -d -- /opt/billar/current/bin/billar-navegador
# Si el navegador se cierra o se cuelga, vuelve a abrirse solo.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
