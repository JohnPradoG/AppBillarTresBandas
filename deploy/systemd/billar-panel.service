[Unit]
Description=Panel de administración por la red del billar (HTTPS)
After=network-online.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=billar
Group=billar
Environment=BILLAR_CONFIG=/etc/billar/billar.toml
ExecStart=/opt/billar/current/venv/bin/billar panel
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=multi-user.target
